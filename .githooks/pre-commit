#!/usr/bin/env bash
set -euo pipefail

command -v gitleaks >/dev/null || {
    echo "BLOCKED: Gitleaks unavailable"
    exit 1
}

root="$(git rev-parse --show-toplevel)"
snapshot="$(mktemp -d)"
trap 'rm -rf -- "$snapshot"' EXIT

cd "$root"
git checkout-index --all --prefix="$snapshot/"

echo "=== GITLEAKS PRE-COMMIT ==="
gitleaks detect \
    --source "$snapshot" \
    --no-git \
    --redact \
    --exit-code 1
