#!/usr/bin/env bash
set -euo pipefail

command -v gitleaks >/dev/null || {
    echo "BLOCKED: Gitleaks unavailable"
    exit 1
}

root="$(git rev-parse --show-toplevel)"
git -C "$root" rev-parse --verify HEAD >/dev/null

echo "=== GITLEAKS PRE-PUSH ==="
gitleaks detect \
    --source "$root" \
    --log-opts="--all" \
    --redact \
    --exit-code 1
