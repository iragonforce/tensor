#!/usr/bin/env python3

import json
import os
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path

NAME_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")

RESERVED = {
    "PATH", "HOME", "SHELL", "USER", "LOGNAME",
    "IFS", "ENV", "BASH_ENV", "ZDOTDIR",
    "TMPDIR", "TMP", "TEMP",
    "SSH_AUTH_SOCK",
    "PYTHONPATH", "PYTHONHOME",
    "PYTHONSTARTUP", "PYTHONINSPECT",
}

BLOCKED_PREFIXES = ("LD_", "DYLD_", "BWS_")

def fail(message):
    print("bwrun:", message, file=sys.stderr)
    sys.exit(1)

def load_token():
    paths = [
        Path.home() / ".config/bws/access-token",
        Path.home() / ".config/bws-nexus/access-token",
    ]

    for path in paths:
        try:
            info = path.lstat()
        except FileNotFoundError:
            continue

        if not stat.S_ISREG(info.st_mode):
            fail("Token must be a regular file")

        if info.st_uid != os.geteuid():
            fail("Token file has incorrect owner")

        if stat.S_IMODE(info.st_mode) != 0o600:
            fail("Token file must have permissions 0600")

        parent = path.parent.stat()
        if stat.S_IMODE(parent.st_mode) & 0o077:
            fail("Token directory permissions are too broad")

        token = path.read_text().strip()

        if not token:
            fail("Machine access token is empty")

        return token

    fail("No Bitwarden machine token found")

def bws_json(binary, auth_env, *arguments):
    try:
        result = subprocess.run(
            [binary, *arguments],
            env=auth_env,
            capture_output=True,
            text=True,
            timeout=45,
            check=False,
        )
    except subprocess.TimeoutExpired:
        fail("Bitwarden request timed out")

    if result.returncode:
        fail("Bitwarden request failed; check authentication and access")

    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        fail("Unexpected Bitwarden response format")

def main():
    args = sys.argv[1:]

    if "--" not in args:
        fail("Usage: bwrun KEY [KEY ...] -- command [args]")

    separator = args.index("--")
    names = args[:separator]
    command = args[separator + 1:]

    if not names or not command:
        fail("Provide at least one secret and a command")

    if len(names) != len(set(names)):
        fail("Duplicate requested secret names")

    for name in names:
        if not NAME_PATTERN.fullmatch(name):
            fail("Invalid environment variable name: " + name)

        if name in RESERVED or name.startswith(BLOCKED_PREFIXES):
            fail("Unsafe environment variable name: " + name)

    binary = shutil.which("bws")
    if not binary:
        fail("bws executable not found")

    auth_env = os.environ.copy()
    auth_env["BWS_ACCESS_TOKEN"] = load_token()

    available = bws_json(binary, auth_env, "secret", "list")

    child_env = os.environ.copy()
    child_env.pop("BWS_ACCESS_TOKEN", None)

    for name in names:
        matches = [
            item for item in available
            if item.get("key") == name
        ]

        if not matches:
            fail("Secret not found or access denied: " + name)

        if len(matches) != 1:
            fail("Ambiguous secret name: " + name)

        secret = bws_json(
            binary,
            auth_env,
            "secret",
            "get",
            matches[0]["id"],
        )

        value = secret.get("value")

        if not isinstance(value, str) or "\0" in value:
            fail("Invalid secret value for: " + name)

        child_env[name] = value

    # Replace this process with the requested application.
    # The machine access token is not passed to the child.
    try:
        os.execvpe(command[0], command, child_env)
    except OSError:
        fail("Unable to execute requested command")

if __name__ == "__main__":
    main()
