#!/usr/bin/env python3
# Copy, import or paste text through the existing tmux clipboard integration. See tmux-copy(1) for source and integration details.
"""On-demand tmux copy/paste and count feedback; never monitors the clipboard."""

if __name__ == "__main__":
    import sys as _ops_sys
    if _ops_sys.argv[1:] == ["--help"]:
        print("Copy, import or paste text through the existing tmux clipboard integration.\nUsage: tmux-copy  [ARGUMENT ...]\nraise ValueError('usage: tmux-copy copy SESSION | paste/import SESSION [PANE]')\nSource: shared/scripts/tmux-copy in ~/ops\nSee man tmux-copy for the existing call sites and argument handling.")
        raise SystemExit(0)
import os
from pathlib import Path
import shutil
import subprocess
import sys

TMUX = shutil.which('tmux') or '/opt/homebrew/bin/tmux'
BUFFER = 'homelab-clipboard'


def run(*args, data=None):
    return subprocess.run([TMUX, *args], input=data, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, check=True)


def clipboard_environment():
    env = os.environ.copy()
    if sys.platform == 'darwin':
        env['LC_CTYPE'] = 'en_US.UTF-8'
    elif not env.get('WAYLAND_DISPLAY'):
        result = subprocess.run(['systemctl', '--user', 'show-environment'],
                                capture_output=True, text=True, timeout=3)
        for line in result.stdout.splitlines():
            key, sep, value = line.partition('=')
            if sep and key in ('WAYLAND_DISPLAY', 'XDG_RUNTIME_DIR', 'DISPLAY'):
                env[key] = value
    return env


def backend(env):
    if sys.platform == 'darwin':
        return ['/usr/bin/pbcopy'], ['/usr/bin/pbpaste']
    if env.get('WAYLAND_DISPLAY') and shutil.which('wl-copy') and shutil.which('wl-paste'):
        return ['wl-copy', '--type', 'text/plain;charset=utf-8'], ['wl-paste', '--no-newline']
    return None, None


def notify(session, message):
    run('set-option', '-t', session, '@copy_status', message)
    run('set-option', '-t', session, 'status', 'on')
    clients = run('list-clients', '-t', session, '-F', '#{client_name}').stdout.decode().splitlines()
    for client in clients:
        run('display-message', '-c', client, '-d', '2000', '#[align=centre]' + message)


def main():
    if len(sys.argv) < 3:
        raise ValueError('usage: tmux-copy copy SESSION | paste/import SESSION [PANE]')
    action, session = sys.argv[1:3]
    env = clipboard_environment()
    writer, reader = backend(env)
    if action == 'copy':
        data = sys.stdin.buffer.read()
        if not data:
            notify(session, 'Nothing selected — drag over text first')
            return
        # Linux tmux may have a Wayland session even when this client is remote.
        # OSC 52 targets the attached terminal in both local and SSH sessions.
        if sys.platform == 'darwin' and writer:
            subprocess.run(writer, input=data, env=env, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, check=True, timeout=5)
            actual = subprocess.run(reader, env=env, capture_output=True, check=True, timeout=5).stdout
            if actual != data:
                raise RuntimeError('Clipboard readback differs; copy not confirmed')
            run('load-buffer', '-b', BUFFER, '-', data=data)
            verb = 'Copied'
        else:
            # Headless tmux: request the attached terminal clipboard through OSC52.
            run('load-buffer', '-b', BUFFER, '-w', '-', data=data)
            verb = 'Copy sent'
        text = data.decode('utf-8', errors='replace')
        lines = text.count('\n') + (0 if text.endswith('\n') else 1)
        notify(session, f'{verb}: {len(text)} characters, {lines} lines')
    elif action in ('paste', 'import'):
        if not reader:
            notify(session, 'Remote paste: use Ctrl+Shift+V for the client clipboard')
            return
        data = subprocess.run(reader, env=env, capture_output=True, check=True, timeout=5).stdout
        run('load-buffer', '-b', BUFFER, '-', data=data)
        if action == 'paste':
            if len(sys.argv) != 4:
                raise ValueError('paste requires a target pane')
            run('paste-buffer', '-p', '-b', BUFFER, '-t', sys.argv[3])
    else:
        raise ValueError('unknown clipboard action')


if __name__ == '__main__':
    try:
        main()
    except Exception:
        # Do not log clipboard contents or exception output from clipboard tools.
        if len(sys.argv) >= 3:
            try:
                notify(sys.argv[2], 'Clipboard operation failed — nothing pasted')
            except Exception:
                pass
        sys.exit(1)
