#!/bin/sh
# Launch Ghostty with the existing Hyprland integration. See ghostty(1) for source and integration details.
# Let Hyprland blur Ghostty without GTK creating an empty background-effects region.
export GDK_WAYLAND_DISABLE="${GDK_WAYLAND_DISABLE:+$GDK_WAYLAND_DISABLE,}ext_background_effect_manager_v1"
exec /usr/bin/ghostty "$@"
