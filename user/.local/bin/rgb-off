#!/bin/sh
# Turn off the configured RGB devices through tensor-control. See rgb-off(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Turn off the configured RGB devices through tensor-control.
Usage: rgb-off 

Source: hosts/tensor/files/.local/bin/rgb-off in ~/ops
See man rgb-off for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi
exec /home/iragonforce/.local/share/tensor-control/venv/bin/python /home/iragonforce/.local/share/tensor-control/tensor-rgb.py off
