#!/usr/bin/env python3

if __name__ == "__main__":
    import sys as _ops_sys
    if _ops_sys.argv[1:] == ["--help"]:
        print('Hide the existing SonoBus window without stopping its audio process.\nUsage: sonobus-hide-window \n\nSource: hosts/tensor/files/.local/bin/sonobus-hide-window in ~/ops\nSee man sonobus-hide-window for the existing call sites and argument handling.')
        raise SystemExit(0)
# Hide the existing SonoBus window without stopping its audio process. See sonobus-hide-window(1) for source and integration details.
import json
import subprocess
import time

def run(*args):
    return subprocess.run(
        args,
        text=True,
        capture_output=True,
        timeout=3
    )

def service_pid():
    result = run(
        "systemctl", "--user", "show",
        "sonobus-dock.service",
        "-p", "MainPID", "--value"
    )
    try:
        return int(result.stdout.strip())
    except ValueError:
        return 0

pid = service_pid()

for attempt in range(40):
    result = run("hyprctl", "-i", "0", "-j", "clients")

    if result.returncode == 0:
        try:
            windows = json.loads(result.stdout)
        except json.JSONDecodeError:
            windows = []

        matches = [
            w for w in windows
            if "sonobus" in (
                str(w.get("class", "")) + " " +
                str(w.get("title", ""))
            ).lower()
        ]

        window = next(
            (w for w in matches if w.get("pid") == pid),
            matches[0] if len(matches) == 1 else None
        )

        if window:
            address = window["address"]

            if window.get("workspace", {}).get("name") == "special:sonobus":
                print("SonoBus already hidden")
                raise SystemExit(0)

            moved = run(
                "hyprctl", "-i", "0",
                "dispatch", "movetoworkspacesilent",
                f"special:sonobus,address:{address}"
            )

            if moved.returncode == 0:
                print(f"SonoBus hidden: PID {window['pid']}")
                raise SystemExit(0)

            print("Move failed:", moved.stderr or moved.stdout)

    time.sleep(0.25)

# Window management must never terminate the audio service.
print("SonoBus window unavailable; audio service unchanged")
