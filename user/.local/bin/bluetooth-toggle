#!/usr/bin/env sh
# Toggle the configured Bluetooth controller power state. See bluetooth-toggle(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Toggle the configured Bluetooth controller power state.
Usage: bluetooth-toggle 

Source: hosts/tensor/files/.local/bin/bluetooth-toggle in ~/ops
See man bluetooth-toggle for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi
set -eu
export LC_ALL=C
case "$(bluetoothctl show)" in
    *"Powered: yes"*) exec bluetoothctl power off ;;
    *"Powered: no"*) exec bluetoothctl power on ;;
    *) printf 'No Bluetooth controller available\n' >&2; exit 1 ;;
esac
