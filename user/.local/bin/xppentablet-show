#!/bin/bash
# Show or hide the XP-Pen settings workspace. See xppentablet-show(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Show or hide the XP-Pen settings workspace.
Usage: xppentablet-show 

Source: hosts/tensor/files/.local/bin/xppentablet-show in ~/ops
See man xppentablet-show for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi
# Toggle XP-Pen tablet settings window via Hyprland special workspace.
# - If PenTablet is not running, launch it (windowrule sends it to special:pentablet)
# - Then toggle the special workspace to show/hide the settings UI

if ! pgrep -x PenTablet > /dev/null; then
    xppentablet-wayland &
    sleep 1
fi

hyprctl dispatch togglespecialworkspace pentablet
