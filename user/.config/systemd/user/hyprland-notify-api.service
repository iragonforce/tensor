[Unit]
Description=Hyprland notification REST API
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/iragonforce/.local/bin/hyprland-notify-api serve
Restart=on-failure
RestartSec=2
Environment=PATH=/home/iragonforce/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
